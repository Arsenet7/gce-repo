pipeline {
    agent { label 'gce-node' }

    parameters {
        booleanParam(name: 'RUN_SONARQUBE', defaultValue: true, description: 'Run SonarQube Analysis')
        string(name: 'K8S_NAMESPACE', defaultValue: 'default', description: 'Kubernetes namespace to deploy to')
        string(name: 'ARGOCD_APP_NAME', defaultValue: 'gce-app', description: 'ArgoCD Application name')
    }

    environment {
        DOCKER_IMAGE = 'arsenet10/gce-repo:latest'
        SONAR_TOKEN = credentials('sonarid') // Sonar token from Jenkins credentials
        GIT_REPO = 'https://github.com/Arsenet7/gce-repo1.git'
        DOCKER_CREDENTIALS_ID = 'dockerhub-ars-id' // Ensure this is set in Jenkins credentials
        GITOPS_REPO = 'https://github.com/Arsenet7/gce-argocd.git' // Your GitOps repository
        GITOPS_BRANCH = 'main' // Branch in your GitOps repository
        GIT_CREDS = credentials('githubs') // GitHub credentials
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'jenkins', url: "${GIT_REPO}"
            }
        }

        stage('Deploy to Nginx') {
            steps {
                sh '''
                sudo cp -r * /var/www/html/
                sudo systemctl restart nginx
                '''
            }
        }

        stage('Test HTML Content') {
            steps {
                sh '''
                curl -I http://52.15.226.21 | grep "200 OK" || exit 1
                '''
            }
        }

        stage('SonarQube Analysis') {
            when {
                expression { params.RUN_SONARQUBE }
            }
            environment {
                SCANNER_HOME = tool 'sonar' // SonarQube scanner tool in Jenkins
            }
            steps {
                script {
                    withSonarQubeEnv('sonar') {
                        sh """
                            ${SCANNER_HOME}/bin/sonar-scanner \
                            -Dsonar.projectKey=gce-app \
                            -Dsonar.host.url=https://sonarqube.devopseasylearning.uk/ \
                            -Dsonar.login=$SONAR_TOKEN \
                            -Dsonar.sources=./
                        """
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker build -t ${DOCKER_IMAGE} .'
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', "${DOCKER_CREDENTIALS_ID}") {
                        sh 'docker push ${DOCKER_IMAGE}'
                    }
                }
            }
        }

        stage('Deploy to Docker Container') {
            steps {
                script {
                    sh '''
                    docker stop gce-repo || true
                    docker rm gce-repo || true
                    docker run -d --name gce-repo -p 8080:80 ${DOCKER_IMAGE}
                    '''
                }
            }
        }
        
        stage('Update GitOps Repository') {
            steps {
                script {
                    // Create a temporary directory
                    sh 'mkdir -p gitops-temp'
                    
                    dir('gitops-temp') {
                        // Clone the GitOps repository
                        withCredentials([usernamePassword(credentialsId: 'githubs', 
                                                        usernameVariable: 'GIT_USERNAME', 
                                                        passwordVariable: 'GIT_PASSWORD')]) {
                            sh """
                                git clone https://${GIT_USERNAME}:${GIT_PASSWORD}@${GITOPS_REPO.replace('https://', '')} .
                                git checkout ${GITOPS_BRANCH}
                            """
                        }
                        
                        // Ensure the app directory exists
                        sh "mkdir -p ${params.ARGOCD_APP_NAME}"
                        
                        // Copy the Kubernetes manifests from main repository
                        sh "cp -r ../k8s/* ${params.ARGOCD_APP_NAME}/"
                        
                        // Update the image tag in the deployment.yaml
                        sh """
                            sed -i 's|image: arsenet10/gce-repo:.*|image: ${DOCKER_IMAGE}|g' ${params.ARGOCD_APP_NAME}/deployment.yaml
                        """
                        
                        // Commit and push the changes
                        withCredentials([usernamePassword(credentialsId: 'githubs', 
                                                        usernameVariable: 'GIT_USERNAME', 
                                                        passwordVariable: 'GIT_PASSWORD')]) {
                            sh """
                                git config user.email "jenkins@example.com"
                                git config user.name "Jenkins"
                                git add ${params.ARGOCD_APP_NAME}/*
                                git commit -m "Update ${params.ARGOCD_APP_NAME} image to ${DOCKER_IMAGE}"
                                git push origin ${GITOPS_BRANCH}
                            """
                        }
                    }
                    
                    // Clean up
                    sh 'rm -rf gitops-temp'
                }
            }
        }
        
        stage('Sync ArgoCD Application') {
            steps {
                script {
                    // Install ArgoCD CLI if not present
                    sh '''
                    if ! command -v argocd &> /dev/null; then
                        curl -sSL -o argocd-linux-amd64 https://github.com/argoproj/argo-cd/releases/latest/download/argocd-linux-amd64
                        sudo install -m 555 argocd-linux-amd64 /usr/local/bin/argocd
                        rm argocd-linux-amd64
                    fi
                    '''
                    
                    // Login to ArgoCD
                    withCredentials([string(credentialsId: 'argocd-token', variable: 'ARGOCD_AUTH_TOKEN')]) {
                        sh """
                            argocd login --auth-token ${ARGOCD_AUTH_TOKEN} --insecure --grpc-web http://134.122.119.201:30719
                            argocd app sync ${params.ARGOCD_APP_NAME}
                            argocd app wait ${params.ARGOCD_APP_NAME} --health
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful 🚀'
        }
        failure {
            echo 'Deployment Failed ❌'
        }
        always {
            // Clean workspace
            cleanWs()
        }
    }
}
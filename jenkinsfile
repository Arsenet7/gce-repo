pipeline {
    agent { label 'gce-node' }

    parameters {
        booleanParam(name: 'RUN_SONARQUBE', defaultValue: true, description: 'Run SonarQube Analysis')
        string(name: 'K8S_NAMESPACE', defaultValue: 'default', description: 'Kubernetes namespace to deploy to')
    }

    environment {
        DOCKER_IMAGE = 'arsenet10/gce-repo:latest'
        SONAR_TOKEN = credentials('sonarid') // Sonar token from Jenkins credentials
        GIT_REPO = 'https://github.com/Arsenet7/gce-repo1.git'
        DOCKER_CREDENTIALS_ID = 'dockerhub-ars-id' // Ensure this is set in Jenkins credentials
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'jenkins', url: "${GIT_REPO}"
            }
        }

        stage('Deploy to Nginx') {
            steps {
                sh '''
                sudo cp -r * /var/www/html/
                sudo systemctl restart nginx
                '''
            }
        }

        stage('Test HTML Content') {
            steps {
                sh '''
                curl -I http://52.14.185.110 | grep "200 OK" || exit 1
                '''
            }
        }

        stage('SonarQube Analysis') {
            when {
                expression { params.RUN_SONARQUBE }
            }
            environment {
                SCANNER_HOME = tool 'sonar' // SonarQube scanner tool in Jenkins
            }
            steps {
                script {
                    // Perform SonarQube analysis using the SonarQube plugin
                    withSonarQubeEnv('sonar') { // 'sonar' is the SonarQube server configured in Jenkins
                        sh """
                            ${SCANNER_HOME}/bin/sonar-scanner \
                            -Dsonar.projectKey=gce-app \
                            -Dsonar.host.url=https://sonarqube.devopseasylearning.uk/ \
                            -Dsonar.login=$SONAR_TOKEN \
                            -Dsonar.sources=./
                        """
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker build -t ${DOCKER_IMAGE} .'
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', "${DOCKER_CREDENTIALS_ID}") {
                        sh 'docker push ${DOCKER_IMAGE}'
                    }
                }
            }
        }

        stage('Deploy to Docker Container') {
            steps {
                script {
                    sh '''
                    docker stop gce-repo || true
                    docker rm gce-repo || true
                    docker run -d --name gce-repo -p 8080:80 ${DOCKER_IMAGE}
                    '''
                }
            }
        }
        
        stage('Install kubectl') {
            steps {
                sh '''
                # Check if kubectl is already installed
                if ! command -v kubectl &> /dev/null; then
                    # Install kubectl
                    curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                    chmod +x kubectl
                    sudo mv kubectl /usr/local/bin/
                fi
                '''
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-credentials-id', variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                    # Check if kubectl is installed
                    kubectl version --client
                    
                    # Apply Kubernetes manifests
                    kubectl --kubeconfig=$KUBECONFIG_FILE apply -f k8s/ -n ${K8S_NAMESPACE}
                    
                    # Wait for deployment to complete
                    DEPLOYMENT=$(kubectl --kubeconfig=$KUBECONFIG_FILE get deployments -n ${K8S_NAMESPACE} -o jsonpath='{.items[0].metadata.name}')
                    kubectl --kubeconfig=$KUBECONFIG_FILE rollout status deployment/${DEPLOYMENT} -n ${K8S_NAMESPACE}
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful 🚀'
        }
        failure {
            echo 'Deployment Failed ❌'
        }
    }
}